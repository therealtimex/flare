# Where the SQLite file lives (default ./.flare-data)
FLARE_DATA_DIR=./.flare-data
# Base URL the agent uses to call the agent-tools API
FLARE_BASE_URL=http://localhost:3020
# Optional: Flexprice usage metering (https://flexprice.io). Without it, metering stays local.
FLEXPRICE_API_KEY=
FLEXPRICE_API_URL=https://api.cloud.flexprice.io/v1
# Optional: Hunter.io email verification. Without it, email status = "pattern".
HUNTER_API_KEY=
