# Where the SQLite file lives (default ./.flare-data)
FLARE_DATA_DIR=./.flare-data
# Base URL the agent uses to call the agent-tools API
FLARE_BASE_URL=http://localhost:3020
# Optional: Flexprice usage metering (https://flexprice.io). Without it, metering stays local.
FLEXPRICE_API_KEY=
# Inject the key from your secret store at launch; never write it to a file.
FLEXPRICE_API_URL=https://us.api.flexprice.io/v1
# external_customer_id sent with every event. `npm run flexprice:setup` creates it plus one
# metered feature per event (lead_enriched, outreach_sent, graph_query; SUM of "units").
FLEXPRICE_CUSTOMER_ID=flare-demo
# "Run GTM agent" dispatch via realtimex-pp-cli (falls back to a copyable brief)
# FLARE_PP_CLI=/absolute/path/to/realtimex-pp-cli
# FLARE_AGENT_NAME=claude
# FLARE_RTX_WORKSPACE=hackwithbay4
# FLARE_RTX_THREAD=flare-agent
# FLARE_RUN_DISPATCH=off
